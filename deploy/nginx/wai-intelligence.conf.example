# Replace wai.example.ca with the host name used for the demonstration.
# Obtain the certificate with Certbot before enabling the HTTPS server block.


server {
    listen 80;
    server_name wai.example.ca;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name wai.example.ca;

    ssl_certificate /etc/letsencrypt/live/wai.example.ca/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wai.example.ca/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:WAI:10m;
    ssl_session_tickets off;

    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 90s;
    }
}
